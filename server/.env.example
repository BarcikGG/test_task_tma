# ── MySQL (MYSQL_* names are used by the official MySQL Docker image) ───
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=task_fund
MYSQL_USER=app
MYSQL_PASSWORD=

# ── NestJS database connection (reads these names via ConfigService) ────
HOST=db
PORT=3306
DATABASE=task_fund
USERNAME=app
PASSWORD=

# ── Telegram ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── App ─────────────────────────────────────────────────────────────────
# Public URL of the Mini App (shown in Telegram WebApp button)
APP_URL=http://your-server-ip:3000
APP_PORT=5094
NODE_ENV=production
